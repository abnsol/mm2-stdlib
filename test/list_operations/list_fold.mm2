
(foldl_data numbers (1 2 3 4))

;; Test 1: Addition (0 + 1 + 2 + 3 + 4 = 10)
(exec 1
    (, (foldl_data $type $x))
    (O  (pure 
            (Test FoldlAtom Add $type $result)
            $result
            (foldl-atom + 0 (' $x))
        )
    )
)

;; Test 2: Subtraction (100 - 1 - 2 - 3 - 4 = 90)
(exec 2
    (, (foldl_data $type $x))
    (O  (pure 
            (Test FoldlAtom Sub $type $result)
            $result
            (foldl-atom - 100 (' $x))
        )
    )
)

;; Test 3: Multiplication (1 * 1 * 2 * 3 * 4 = 24)
(exec 3
    (, (foldl_data $type $x))
    (O  (pure 
            (Test FoldlAtom Mul $type $result)
            $result
            (foldl-atom * 1 (' $x))
        )
    )
)