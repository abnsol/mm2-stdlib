(map_data numbers (1 2 3 4))

;; Test 1: Addition with value (+ 20) -> (21 22 23 24)
(exec 1
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Add20 $type $result)
            $result
            (map-atom + 20 (' $x))
        )
    )
)

;; Test 2: Multiplication with value (* 6) -> (6 12 18 24)
(exec 2
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Mul6 $type $result)
            $result
            (map-atom * 6 (' $x))
        )
    )
)

;; Test 3: Self square (* self) -> (1 4 9 16)
(exec 3
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Square $type $result)
            $result
            (map-atom * self (' $x))
        )
    )
)

;; Test 4: Self double (+ self) -> (2 4 6 8)
(exec 4
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Double $type $result)
            $result
            (map-atom + self (' $x))
        )
    )
)

;; Test 5: Subtract (- 2) -> (-1 0 1 2)
(exec 5
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Sub2 $type $result)
            $result
            (map-atom - 2 (' $x))
        )
    )
)

;; Test 6: Divide (/ 2) -> (0.5 1 1.5 2)
(exec 6
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Div2 $type $result)
            $result
            (map-atom / 2 (' $x))
        )
    )
)

;; Test 7: Modulo (% 2) -> (1 0 1 0)
(exec 7
    (, (map_data $type $x))
    (O  (pure 
            (Test MapAtom Mod2 $type $result)
            $result
            (map-atom % 2 (' $x))
        )
    )
)
