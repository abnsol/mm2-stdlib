;; Tests for list set operations: unique-atom, intersection-atom, subtraction-atom, union-atom, and append.
;; Validates behavior on lists with and without duplicate elements.

;; ---------------- DATA with DUPLICATES ----------------
(dup_data no_dups (a b c))
(dup_data with_dups (a b a c d))
(dup_data all_dups (x x x))

;; ---------------- 1. UNIQUE-ATOM ----------------
(exec 1
    (, (dup_data $type $x))
    (O  (pure 
            (Test Unique $type $result)
            $result
            (unique-atom (' $x))
        )
    )
)

;; ---------------- DATA for BINARY OPS ----------------
(bin_data list1 (a b c d))
(bin_data list2 (b d e))
(bin_data listA (a a b c))
(bin_data listB (a b b c))

;; ---------------- 2. INTERSECTION-ATOM ----------------
(exec 2
    (, (bin_data list1 $a) (bin_data list2 $b))
    (O  (pure 
            (Test Intersection $a $b $result)
            $result
            (intersection-atom (' ($a $b)))
        )
    )
)

;; ---------------- 3. SUBTRACTION-ATOM ----------------
(exec 3
    (, (bin_data list1 $a) (bin_data list2 $b))
    (O  (pure 
            (Test Subtraction $a $b $result)
            $result
            (subtraction-atom (' ($a $b)))
        )
    )
)

;; ---------------- 4. UNION-ATOM ----------------
(exec 4
    (, (bin_data list1 $a) (bin_data list2 $b))
    (O  (pure 
            (Test Union $a $b $result)
            $result
            (union-atom (' ($a $b)))
        )
    )
)

;; ---------------- 5. APPEND ----------------
(exec 5
    (, (bin_data list1 $a) (bin_data list2 $b))
    (O  (pure 
            (Test Append $a $b $result)
            $result
            (append (' ($a $b)))
        )
    )
)

;; ---------------- 6. QUOTED LITERAL REGRESSION ----------------
;; Binary list functions must also work when the first argument is quoted.
(exec 6
    (,)
    (O  (pure
            (Test UnionQuotedLiteral $result)
            $result
            (union-atom (' ((a a b) (b c c))))
        )
        (pure
            (Test AppendQuotedLiteral $result)
            $result
            (append (' ((a a b) (b c c))))
        )
        (pure
            (Test IntersectionQuotedLiteral $result)
            $result
            (intersection-atom (' ((a a b c) (a b b c c))))
        )
        (pure
            (Test SubtractionQuotedLiteral $result)
            $result
            (subtraction-atom (' ((a a b c) (a c))))
        )
    )
)

;; ---------------- 7. TUPLE ARGUMENT REGRESSION ----------------
;; The same binary functions should also accept tuple-produced packed arguments.
(exec 7
    (,)
    (O  (pure
            (Test UniqueTupleArg $result)
            $result
            (unique-atom (tuple a b a c))
        )
        (pure
            (Test UnionTuplePacked $result)
            $result
            (union-atom (tuple (tuple a a b) (tuple b c c)))
        )
        (pure
            (Test AppendTuplePacked $result)
            $result
            (append (tuple (tuple a a b) (tuple b c c)))
        )
        (pure
            (Test IntersectionTuplePacked $result)
            $result
            (intersection-atom (tuple (tuple a a b c) (tuple a b b c c)))
        )
        (pure
            (Test SubtractionTuplePacked $result)
            $result
            (subtraction-atom (tuple (tuple a a b c) (tuple a c)))
        )
    )
)
